#!/usr/bin/env zsh
set -euo pipefail

# Keep Stow from folding these application directories into directory-level
# symlinks. The shared Markdown files should be linked individually, while the
# optional machine overlay at ~/.config/agents/machine.md remains unmanaged.
mkdir -p "$HOME/.codex" "$HOME/.claude"

# Install portable Codex defaults below the mutable user configuration layer.
_codex_system_source="$DOTFILES/codex-system/etc/codex/config.toml"
_codex_system_target="/etc/codex/config.toml"
if [[ -f "$_codex_system_source" ]]; then
    if [[ -e "$_codex_system_target" || -L "$_codex_system_target" ]]; then
        if [[ ! -L "$_codex_system_target" || "$(readlink "$_codex_system_target")" != "$_codex_system_source" ]]; then
            print -u2 -- "Refusing to replace existing $_codex_system_target"
            exit 1
        fi
    else
        sudo mkdir -p /etc/codex
        sudo ln -s "$_codex_system_source" "$_codex_system_target"
    fi
fi
unset _codex_system_source _codex_system_target

pushd $DOTFILES

# The private Roblox package is optional. An initialized submodule has a .git
# file; an uninitialized submodule is intentionally skipped on other machines.
if [[ -f "$DOTFILES/roblox/.git" && ",$STOW_FOLDERS," != *",roblox,"* ]]; then
    STOW_FOLDERS="$STOW_FOLDERS,roblox"
fi

for folder in $(echo $STOW_FOLDERS | sed "s/,/ /g")
do
    echo "stow $folder"
    stow -D $folder
    stow $folder
done
popd

